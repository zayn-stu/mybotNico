# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Channel ID for logging when members leave (required for leave logs to work)
MEMBER_LEAVE_LOG_CHANNEL_ID=your_leave_log_channel_id_here

# Comma-separated Discord user IDs allowed to run owner-only commands (e.g. !reset)
BOT_OWNER_IDS=your_discord_user_id_here

# Optional persistent-storage root. On Railway, set this to the volume mount path.
# Runtime JSON will be stored in DATA_DIR/data/ and seeded from the committed data files.
DATA_DIR=

# Enable verbose Discord voice connection diagnostics only while debugging.
VOICE_DEBUG=false

# The guild ID to enable verbose panda logging and member leave tracking for
SOCIALS_GUILD_ID=your_guild_id_here

# Channel ID in Social's Nightclub where each server ad is a separate message
SOCIALS_GUILD_SERVER_ADS_CHANNEL_ID=your_socials_server_ads_channel_id_here

# Name of the custom emoji to react with when a panda is awarded
PANDA_EMOJI_NAME=SN_RooHappi

# Role ID of the separator role used to position custom color roles below it (top boundary)
COLOR_SEPARATOR_ROLE_ID=your_color_separator_role_id_here

# Role ID of the bots separator role (bottom boundary for color roles)
BOTS_SEPARATOR_ROLE_ID=your_bots_separator_role_id_here

# Guild ID for Degeneracy server (where panda staff hide/show is available)
DEGENERACY_GUILD_ID=your_degeneracy_guild_id_here

# General channel ID for Degeneracy server
DEGENERACY_GENERAL_CHANNEL_ID=your_degeneracy_general_channel_id_here

# Partner channel ID for Degeneracy server
DEGENERACY_PARTNER_CHANNEL_ID=your_degeneracy_partner_channel_id_here

# Role ID of the staff role (used to mark staff on panda leaderboard)
DEGENERACY_STAFF_ROLE_ID=your_staff_role_id_here
